{
    "name": "php-concept/recipes",
    "description": "Concept 2 — runnable recipe apps for documentation",
    "require": {
        "php": "^8.4",
        "php-concept/core-2": "^1.0",
        "php-concept/stack": "^2.0",
        "php-concept/extension-config": "^1.0",
        "php-concept/extension-path-manager": "^1.0",
        "php-concept/extension-json": "^1.0",
        "php-concept/brick-casting-valinor": "^1.0",
        "php-concept/brick-console-symfony": "^1.0",
        "php-concept/brick-database-eloquent": "^1.0",
        "php-concept/brick-data-masker": "^1.0",
        "php-concept/brick-error-handler-whoops": "^1.0",
        "php-concept/brick-http": "^1.0",
        "php-concept/brick-logger-monolog": "^1.0",
        "php-concept/brick-session-symfony": "^1.0",
        "php-concept/brick-validation-rakit": "^1.0",
        "php-concept/brick-view": "^1.0",
        "twbs/bootstrap": "^5.3",
        "twbs/bootstrap-icons": "^1.13"
    },
    "scripts": {
        "post-install-cmd": [
            "@publish-assets"
        ],
        "post-update-cmd": [
            "@publish-assets"
        ],
        "publish-assets": [
            "mkdir -p public/vendor/bootstrap",
            "cp -R vendor/twbs/bootstrap/dist/. public/vendor/bootstrap/",

            "mkdir -p public/vendor/bootstrap-icons",
            "cp -R vendor/twbs/bootstrap-icons/font/. public/vendor/bootstrap-icons/"
        ]
    },
    "autoload": {
        "psr-4": {
            "Concept\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    }
}
