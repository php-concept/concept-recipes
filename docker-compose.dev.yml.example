# Local DX: copy to docker-compose.yml (gitignored).
# Requires sibling repos under /var/www/ and COMPOSER=composer-dev.json (path repos + symlinks).
#
#   cp docker-compose.dev.yml.example docker-compose.yml
#   COMPOSER=composer-dev.json composer install
#   docker compose up -d --build
#   docker compose exec app php bin/console.php db:migrate
services:
  app:
    build: .
    container_name: concept_recipes
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    ports:
      - "8089:80"
    volumes:
      - .:/var/www/html
      - ../concept-core-2:/var/www/concept-core-2
      - ../concept-stack:/var/www/concept-stack
      - ../concept-extensions:/var/www/concept-extensions
      - ../concept-bricks:/var/www/concept-bricks
      - ./docker/apache/vhost.conf:/etc/apache2/sites-available/000-default.conf
      - ./docker/php/error-reporting.ini:/usr/local/etc/php/conf.d/error-reporting.ini
    environment:
      - COMPOSER=composer-dev.json
      - MYSQL_HOST=db
      - MYSQL_DATABASE=concept_recipes
      - MYSQL_USER=root
      - MYSQL_PASSWORD=root
    depends_on:
      - db

  db:
    image: mysql:8.4
    command: --mysql-native-password=ON
    container_name: concept_recipes_db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: concept_recipes
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3366:3306"
