services:
  app:
    build: .
    container_name: concept_recipes
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    ports:
      - "8089:80"
    volumes:
      - .:/var/www/html
      - ./docker/apache/vhost.conf:/etc/apache2/sites-available/000-default.conf
      - ./docker/php/error-reporting.ini:/usr/local/etc/php/conf.d/error-reporting.ini
    environment:
      - MYSQL_HOST=db
      - MYSQL_DATABASE=concept_recipes
      - MYSQL_USER=root
      - MYSQL_PASSWORD=root
    depends_on:
      - db

  db:
    image: mysql:8.4
    command: --mysql-native-password=ON
    container_name: concept_recipes_db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: concept_recipes
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3366:3306"
