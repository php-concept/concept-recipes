# Copy to .env — Config extension reads this file (not docker-compose `environment:` alone).
# Keys map to config: DB_HOST → db.host, APP_DEBUG → app.debug (see extension-config mergeEnvData).
# APP_ENV=dev → overlay config/dev/*.php when that directory exists (skeleton; optional in recipes).

APP_DEBUG=1
APP_ENV=dev

DB_DRIVER=mysql
DB_HOST=concept_recipes_db
DB_PORT=3306
DB_DATABASE=concept_recipes
DB_USERNAME=root
DB_PASSWORD=root
